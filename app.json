{
  "expo": {
    "name": "bricknest",
    "slug": "bricknest",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/bricknest.png",
    "scheme": "bricknest",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "kribb",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "LSApplicationQueriesSchemes": [
          "upi",
          "paytmmp",
          "tez",
          "phonepe"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/bricknest.png",
        "backgroundImage": "./assets/images/bricknest.png",
        "monochromeImage": "./assets/images/bricknest.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.kribb"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/bricknest.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-font",
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "31ba4fa5-e4cc-468c-b21a-a2c513a5299a"
      }
    }
  }
}